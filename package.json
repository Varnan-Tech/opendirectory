{
  "name": "opendirectory-cli-root",
  "private": true,
  "version": "1.0.1",
  "scripts": {
    "test": "vitest",
    "build:plugin": "tsx scripts/build-claude-plugin.ts",
    "build:docs": "tsx scripts/build-mintlify-docs.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "esbuild": ">=0.28.1",
      "postcss>nanoid": "3.3.18",
      "source-map-js": "^1.2.2"
    }
  },
  "lint-staged": {
    "skills/**": [
      "tsx scripts/update-readme.ts",
      "tsx scripts/update-contributing.ts",
      "tsx scripts/build-mintlify-docs.ts",
      "git add README.md CONTRIBUTING.md docs"
    ]
  }
}
